# PostgreSQL connection for FastAPI. Keep this value in backend/.env or a
# deployment secret store; never expose it through NEXT_PUBLIC_* variables.
DATABASE_URL=
APP_ENV=development
DB_DISABLE_PREPARED_STATEMENTS=false
SESSION_TTL_SECONDS=604800
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta
