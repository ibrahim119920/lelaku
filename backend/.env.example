# Postgres (Supabase untuk development). Wajib pakai driver asyncpg.
# Kalau pakai Supabase pooler (port 6543, transaction mode), set DB_DISABLE_STATEMENT_CACHE=true.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lelaku
DB_DISABLE_STATEMENT_CACHE=false

# Harus sama dengan secret yang dipakai modul auth untuk menandatangani access token.
JWT_SECRET=change-me-in-development-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_COOKIE_NAME=access_token

# Zona waktu untuk menafsirkan query `date`/`time` di GET /trips.
APP_TIMEZONE=Asia/Jakarta

# Origin frontend yang boleh akses API (dipisah koma).
CORS_ORIGINS=http://localhost:3000
