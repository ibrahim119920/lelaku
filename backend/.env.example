# Postgres (Supabase untuk development). Boleh "postgresql://..." dari Supabase;
# otomatis dipakai dengan driver asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lelaku
# Database KHUSUS test. Test melakukan drop/truncate seluruh tabel; jangan arahkan
# ke database development atau Supabase. Boleh juga diisi lewat environment variable.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lelaku_test
# Pooler Supabase mode transaction (port 6543) tidak mendukung prepared statement cache -> true.
DB_DISABLE_STATEMENT_CACHE=false

# development: cookie sesi tanpa flag Secure (agar jalan di http://localhost).
# Selain "dev"/"development" cookie memakai Secure (wajib HTTPS).
APP_ENV=development
# Masa berlaku sesi login dalam detik (300 .. 2592000). Default 7 hari.
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=lelaku_session

# Zona waktu untuk menafsirkan query `date`/`time` di GET /trips.
APP_TIMEZONE=Asia/Jakarta

# Origin frontend yang boleh akses API (dipisah koma).
CORS_ORIGINS=http://localhost:3000
